<?xml version="1.0" ?>

<launch>
    <arg name="robot_type" default="$(env ROBOT_TYPE)" doc="Robot type: [lt, go1]"/>
    <arg name="rviz" default="true"/>

     <!-- make the files into global parameters -->
    <param name="debug" value="false"/>
    <param name="urdfFile"          value="$(find legged_pdd_description)/urdf/pdd.urdf"/>
    <arg name="urdfFile" default="$(find legged_pdd_description)/urdf/pdd.urdf"/>
    <arg name="record_data" default="false"/>

    <group if="$(eval robot_type=='pdd')">
        <include file="$(find legged_bridge_hw)/launch/legged_bridge_hw.launch"/>
    </group>

    <param name="robot_description" textfile="$(find legged_pdd_description)/urdf/pdd.urdf" />
    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher">
        <param name="publish_frequency" type="double" value="50.0" />
        <param name="tf_prefix" value="" />
    </node>

    <node pkg="modified_rl_controllers" type="timedelay_launch.sh" name="timedelay_launch" args="2 modified_rl_controllers load_ac_controller.launch" output="screen">
    </node>

    <group if="$(arg rviz)">
        <param name="robot_description" textfile="$(arg urdfFile)"/>
        <arg name="rvizconfig" default="$(find modified_rl_controllers)/rviz/legged_robot.rviz" />
        <node pkg="rviz" type="rviz" name="rviz" args="-d $(arg rvizconfig)" output="screen" />
      </group>

      <group if="$(arg record_data)">
        <include file="$(find modified_rl_controllers)/launch/record_data.launch"/>
    </group>
</launch>