<?xml version="1.0" ?>

<launch>
    <include file="$(find modified_rl_controllers)/launch/joy_teleop.launch"/>
    
    <param name="policyFile" value="$(find modified_rl_controllers)/policy/stand_202509282043.onnx"/> 

    <rosparam file="$(find modified_rl_controllers)/config/controllers.yaml" command="load"/>
    <rosparam file="$(find modified_rl_controllers)/config/fairy_amp.yaml" command="load"/>

    <node name="controller_spawner" pkg="controller_manager" type="spawner" 
        respawn="false" output="screen" args="
            controllers/custom_ac_controller
            controllers/joint_state_controller"/>

    <node name="rqt_reconfigure" pkg="rqt_reconfigure" type="rqt_reconfigure" output="screen">
    </node>

</launch>
