<?xml version="1.0" ?>
<robot name="fairy" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="fairy">
    
    <!-- include files -->
    <xacro:include filename="$(find fairy_description)/urdf/common.xacro" />
    <xacro:include filename="$(find fairy_description)/urdf/common_gazebo.xacro"/>
    <xacro:include filename="$(find fairy_description)/urdf/fairy_leg_macro.xacro" />
    
    <!-- new base link -->
    <link name="base_link">
    </link>

    <!-- joint between base_link and body_link -->
    <joint name="base_to_body" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="base_link"/>
      <child link="body_link"/>
    </joint>

    <!-- body link -->
    <link name="body_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://fairy_description/meshes/BASE.STL" scale="1 1 1"/>
          <!-- <mesh filename="package://fairy_description/meshes/base.stl" scale="0.001 0.001 0.001"/> -->
        </geometry>
        <material name="White"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://fairy_description/meshes/BASE.STL" scale="1 1 1"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="12.72349"/>
        <origin xyz="-0.00 0.00 -0.00474" rpy="0 0 0"/>
        <inertia ixx="0.1" ixy="0.0000" ixz="0.000000"   iyy="0.1" iyz="0.0" izz="0.1"/>
      </inertial>
    </link>
    
    <!-- IMU sensor -->
    <link name="imu_link">
      <inertial>
        <mass value="0.001"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.000001" ixy="0.0" ixz="0.0" iyy="0.000001" iyz="0.0" izz="0.000001"/>
      </inertial>
      <visual>
        <geometry>
          <box size="0.05 0.05 0.05"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </visual>
    </link>
    <joint name="base_to_imu" type="fixed">
      <parent link="base_link"/>
      <child link="imu_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    
    <gazebo>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu.so">
        <ros>
          <remapping>my_imu:=/imu/data</remapping>
        </ros>
        <alwaysOn>true</alwaysOn>
        <updateRate>50.0</updateRate>
        <bodyName>imu_link</bodyName>
        <gaussianNoise>0.0</gaussianNoise>
      </plugin>
    </gazebo>

    <!-- left forward joint -->
    <joint name="base_to_left_forward_base" type="fixed">
      <origin xyz="0.000 0.0800 0" rpy="0 0 0"/>
      <parent link="body_link"/>
      <child link="L_FOOT"/>
    </joint>
    <!-- left forward -->
    <xacro:fairy_leg prefix="L"/>

    <!-- right forward joint -->
    <joint name="base_to_right_forward_base" type="fixed">
      <origin xyz="0.000 -0.0800 0" rpy="0 0 0"/>
      <parent link="body_link"/>
      <child link="R_FOOT"/>
    </joint>
    <!-- right forward -->
    <xacro:fairy_leg prefix="R"/>

  </xacro:macro>

</robot>
