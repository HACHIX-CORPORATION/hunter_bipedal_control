<?xml version="1.0" ?>
<robot name="fairy" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="fairy_leg" params="prefix">

    <!-- include files -->
    <xacro:include filename="$(find fairy_description)/urdf/common.xacro" />
    <xacro:include filename="$(find fairy_description)/urdf/common_gazebo.xacro" />
  
    <!-- joint limits [rad] -->
    <xacro:property name="j1_lower_limit" value="${radians(-120)}"/>
    <xacro:property name="j1_upper_limit" value="${radians(120)}"/>
    <xacro:property name="j2_lower_limit" value="${radians(-170)}"/>
    <xacro:property name="j2_upper_limit" value="${radians(30)}"/>
    <xacro:property name="j3_lower_limit" value="${radians(-120)}"/>
    <xacro:property name="j3_upper_limit" value="${radians(180)}"/>
    <xacro:property name="j4_lower_limit" value="${radians(-120)}"/>
    <xacro:property name="j4_upper_limit" value="${radians(120)}"/>

    <!-- joint velocity limits [rad/s] -->
    <xacro:property name="j1_velocity_limit" value="${radians(120)}"/>
    <xacro:property name="j2_velocity_limit" value="${radians(120)}"/>
    <xacro:property name="j3_velocity_limit" value="${radians(120)}"/>
    <xacro:property name="j4_velocity_limit" value="${radians(120)}"/>

    <!-- set joint mesh path -->
    <xacro:property name="L1" value="package://fairy_description/meshes/LHIP.STL"/>
    <xacro:property name="L2" value="package://fairy_description/meshes/LULEG.STL"/>
    <xacro:property name="L3" value="package://fairy_description/meshes/LLLEG.STL"/>
    <xacro:property name="L4" value="package://fairy_description/meshes/LTOE.STL"/>
    <xacro:property name="R1" value="package://fairy_description/meshes/RHIP.STL"/>
    <xacro:property name="R2" value="package://fairy_description/meshes/RULEG.STL"/>
    <xacro:property name="R3" value="package://fairy_description/meshes/RLLEG.STL"/>
    <xacro:property name="R4" value="package://fairy_description/meshes/RTOE.STL"/>
    <xacro:property name="EEF" value="package://fairy_description/meshes/eef.stl"/>

    <!-- joint and link configurations -->
    <xacro:if value="${prefix == 'L'}">
      <xacro:property name="J1" value="${L1}"/>
      <xacro:property name="J2" value="${L2}"/>
      <xacro:property name="J3" value="${L3}"/>
      <xacro:property name="J4" value="${L4}"/>
    </xacro:if>
    <xacro:if value="${prefix == 'R'}">
      <xacro:property name="J1" value="${R1}"/>
      <xacro:property name="J2" value="${R2}"/>
      <xacro:property name="J3" value="${R3}"/>
      <xacro:property name="J4" value="${R4}"/>
    </xacro:if>

    <!-- base link -->
    <link name="${prefix}_FOOT">
      <inertial>
        <mass value="0.001"/>
        <inertia ixx="0.000000" ixy="0.000000" ixz="0.000000" iyy="0.000000" iyz="0.000000" izz="0.000000"/>
      </inertial>
    </link>

    <!-- joint 1 -->
    <joint name="${prefix}_CROTCH_R" type="revolute">
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <axis xyz="1 0 0" rpy="0 0 0"/>
      <limit effort="1000.0" lower="${j1_lower_limit}" upper="${j1_upper_limit}" velocity="${j1_velocity_limit}"/>
      <parent link="${prefix}_FOOT"/>
      <child link="${prefix}1"/>
    </joint>

    <!-- link 1 -->
    <link name="${prefix}1">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${J1}"/>
        </geometry>
        <material name="White"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${J1}" scale="0.002 0.002 0.002"/>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <inertial>
        <origin xyz="-0.00 -0.0 0.00000"/>
        <mass value="1.23047"/>
        <inertia ixx="0.1" ixy="0.0000" ixz="0.000000"   iyy="0.1" iyz="0.0" izz="0.1"/>
      </inertial>
    </link>

    <!-- joint 2 -->
    <joint name="${prefix}_CROTCH_P" type="revolute">
      <xacro:if value="${prefix == 'L'}">
        <origin xyz="0 0.065 0" rpy="0 0 0"/>
      </xacro:if>
      <xacro:if value="${prefix == 'R'}">
        <origin xyz="0 -0.065  0" rpy="0 0 0"/>
      </xacro:if>

      <axis xyz="0 1 0" rpy="0 0 0"/>
      <limit effort="1000.0" lower="${j2_lower_limit}" upper="${j2_upper_limit}" velocity="${j2_velocity_limit}"/>
      <parent link="${prefix}1"/>
      <child link="${prefix}2"/>
    </joint>
   
    <!-- link 2 -->
    <link name="${prefix}2">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${J2}"/>
        </geometry>
        <material name="White"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${J2}"/>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <inertial>
        <origin xyz="0.00006 -0.0 -0.05962"/>
        <mass value="2.06632"/>
        <inertia ixx="0.1" ixy="0.0000" ixz="0.000000"   iyy="0.1" iyz="0.0" izz="0.1"/>
      </inertial>
    </link>

    <!-- joint 3 -->
    <joint name="${prefix}_KNEE_P" type="revolute">
      <axis xyz="0 1 0" rpy="0 0 0"/>
      <limit effort="1000.0" lower="${j3_lower_limit}" upper="${j3_upper_limit}" velocity="${j3_velocity_limit}"/>
      <origin xyz="0 0 -0.2600" rpy="0 0 0"/>
      <parent link="${prefix}2"/>
      <child link="${prefix}3"/>
    </joint>

    <!-- link 3 -->
    <link name="${prefix}3">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${J3}"/>
        </geometry>
        <material name="White"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${J3}"/>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <inertial>
        <origin xyz="0.00000 -0.00 -0.19822"/>
        <mass value="0.41492"/>
        <inertia ixx="0.1" ixy="0.0000" ixz="0.000000"   iyy="0.1" iyz="0.0" izz="0.1"/>
      </inertial>
    </link>


    <!-- joint 4 -->
    <joint name="${prefix}_TOE_P" type="revolute">
      <axis xyz="0 1 0" rpy="0 0 0"/>
      <limit effort="1000.0" lower="${j4_lower_limit}" upper="${j4_upper_limit}" velocity="${j4_velocity_limit}"/>
      <origin xyz="0 0 -0.30056" rpy="0 0 0"/>
      <parent link="${prefix}3"/>
      <child link="${prefix}4"/>
    </joint>

    <!-- link 4 -->
    <link name="${prefix}4">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
           <mesh filename="${J4}"/>
        </geometry>
        <material name="White"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${J4}"/>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <inertial>
        <origin xyz="0.00000 -0.00 -0.04246"/>
        <mass value="0.001"/>
        <inertia ixx="0.1" ixy="0.0000" ixz="0.000000"   iyy="0.1" iyz="0.0" izz="0.1"/>
      </inertial>
    </link>







    <!-- tip link with spring-damper system -->
    <joint name="${prefix}_TIP" type="fixed">
      <origin xyz="0.0 0 -0.035" rpy="0 0 0"/>
      <parent link="${prefix}4"/>
      <child link="${prefix}_TIP"/>
      <dynamics damping="0.05" spring_stiffness="1000.0"/>
    </joint>

    <link name="${prefix}_TIP">
      <visual>
        <xacro:if value="${prefix == 'L'}">
          <origin xyz="0.02 -0.01 -0.015" rpy="0 0 0"/>
        </xacro:if>
        <xacro:if value="${prefix == 'R'}">
          <origin xyz="0.02 0.01  -0.015" rpy="0 0 0"/>
        </xacro:if>

        <geometry>
          <box size="0.06 0.05 0.001"/>          
        </geometry>
        <material name="Red"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.06 0.05 0.001"/>          
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.5</mu>
              <mu2>1.5</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <inertial>
        <origin xyz="0 0 0"/>
        <mass value="0.001"/>
        <inertia ixx="0.0001" ixy="0.0001" ixz="0.0001" iyy="0.0001" iyz="0.0001" izz="0.0001"/>
      </inertial>
    </link>

    <gazebo reference="${prefix}_TIP">
      <material>Gazebo/Red</material>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <mu1>1.5</mu1>
      <mu2>1.5</mu2>
      <fdir1>1 0 0</fdir1>
      <maxVel>1.0</maxVel>
      <minDepth>0.001</minDepth>
    </gazebo>

    <!-- transmissions -->
    <transmission name="${prefix}_transmission1">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${prefix}_CROTCH_R">
        <!-- <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface> -->
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="${prefix}_actuator1">
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <transmission name="${prefix}_transmission2">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${prefix}_CROTCH_P">
        <!-- <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface> -->
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="${prefix}_actuator2">
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <transmission name="${prefix}_transmission3">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${prefix}_KNEE_P">
        <!-- <hardwareInterface>hardware_interface/PositonJointInterface</hardwareInterface> -->
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="${prefix}_actuator3">
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <transmission name="${prefix}_transmission4">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${prefix}_TOE_P">
        <!-- <hardwareInterface>hardware_interface/PositonJointInterface</hardwareInterface> -->
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="${prefix}_actuator4">
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

  </xacro:macro>

</robot>
